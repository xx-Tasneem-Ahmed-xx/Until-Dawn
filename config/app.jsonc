{
  "start-scene": "play",
  "window": {
    "title": "Until Dawn",
    "size": {
      "width": 1280,
      "height": 720
    },
    "fullscreen": false
  },
  "scene": {
    "renderer": {
      "sky": "assets/textures/sky.jpg",
      "postprocess": "assets/shaders/postprocess/muzzle-flash.frag"
    },
    "assets": {
      "shaders": {
        "tinted": {
          "vs": "assets/shaders/tinted.vert",
          "fs": "assets/shaders/tinted.frag"
        },
        "textured": {
          "vs": "assets/shaders/textured.vert",
          "fs": "assets/shaders/textured.frag"
        }
      },
      "textures": {
        "grass": "assets/textures/grass_ground_d.jpg",
        "wood": "assets/textures/wood.jpg"
      },
      "meshes": {
        "plane": "assets/models/plane.obj",
        "pistol": "assets/models/pistol.glb",
        "rifle": "assets/models/Assault Rifle.glb",
        "pickup-health": "assets/models/HealthBox.glb",
        "zombie": "assets/models/Zombie.glb"
      },
      "samplers": {
        "default": {},
        "nearest": {
          "MAG_FILTER": "GL_NEAREST"
        },
        "pixelated": {
          "MAG_FILTER": "GL_NEAREST"
        }
      },
      "materials": {
        "metal": {
          "type": "tinted",
          "shader": "tinted",
          "pipelineState": {
            "faceCulling": {
              "enabled": false
            },
            "depthTesting": {
              "enabled": true
            }
          },
          "tint": [0.45, 0.4, 0.5, 1]
        },
        "glass": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": {
              "enabled": false
            },
            "depthTesting": {
              "enabled": true
            },
            "blending": {
              "enabled": true,
              "sourceFactor": "GL_SRC_ALPHA",
              "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
            },
            "depthMask": false
          },
          "transparent": true,
          "tint": [1, 1, 1, 1],
          "texture": "glass",
          "sampler": "pixelated"
        },
        "grass": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": {
              "enabled": false
            },
            "depthTesting": {
              "enabled": true
            }
          },
          "tint": [1, 1, 1, 1],
          "texture": "grass",
          "sampler": "default"
        },
        "auto": {
          "type": "tinted",
          "shader": "tinted",
          "pipelineState": {
            "faceCulling": {
              "enabled": false
            },
            "depthTesting": {
              "enabled": true
            }
          },
          "tint": [1, 1, 1, 1]
        }
      }
    },
    "world": [
      {
        "name": "MainPlayer",
        "position": [0, 0, 10],
        "components": [
          {
            "type": "Player",
            "isMainPlayer": true
          },
          {
            "type": "Health",
            "maxHealth": 100,
            "currentHealth": 100
          },
          {
            "type": "Pistol"
          }
        ],
        "children": [
          {
            "name": "MainCamera",
            "components": [
              {
                "type": "Camera"
              },
              {
                "type": "Free Camera Controller"
              }
            ],
            "children": [
              {
                "position": [1, -1, -1],
                "rotation": [-110, -80, 180],
                "scale": [40, 40, 40],
                "components": [
                  {
                    "type": "Mesh Renderer",
                    "mesh": "pistol",
                    "material": "auto"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "position": [6, 7, 10],
        "rotation": [0, 0, 0],
        "scale": [0.5, 0.5, 0.5],
        "components": [
          {
            "type": "Mesh Renderer",
            "mesh": "rifle",
            "material": "auto"
          }
        ]
      },
      {
        "position": [6, 5, 10],
        "rotation": [0, 0, 0],
        "scale": [10, 10, 10],
        "components": [
          {
            "type": "Mesh Renderer",
            "mesh": "pickup-health",
            "material": "auto"
          }
        ]
      },
      {
        "position": [0, -0.5, 9.2],
        "rotation": [0, 90, 0],
        "scale": [1, 1, 1],
        "components": [
          {
            "type": "Mesh Renderer",
            "mesh": "zombie",
            "material": "auto"
          }
        ]
      }
    ]
  }
}
